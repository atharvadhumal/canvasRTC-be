# Server
PORT=3000

# Database (PostgreSQL — e.g. Neon pooled connection string)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Auth — generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-here

# Frontend URLs (used for CORS, email links, redirects)
CLIENT_URL=http://localhost:5173
CLIENT_URLS=http://localhost:5173,http://localhost:3000

# Email (Brevo API v3 — key must start with xkeysib-)
# https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your-api-key-here
EMAIL_FROM=you@example.com
EMAIL_FROM_NAME=CanvasRTC

# WebRTC ICE servers (optional — STUN has a default)
STUN_URL=stun:stun.l.google.com:19302
# TURN_URL=turn:your-turn-server:3478?transport=udp
# TURN_USERNAME=
# TURN_CREDENTIAL=

# Set to true in production to log verification/reset links when email fails
LOG_EMAIL_LINKS=true
